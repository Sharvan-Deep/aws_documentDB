# ═══════════════════════════════════════════════════════════
# backend/.env.example — Copy to .env and fill in real values
# ═══════════════════════════════════════════════════════════
# NEVER commit .env (it is git-ignored).
# This file ONLY contains variable names and safe placeholders.
# ═══════════════════════════════════════════════════════════

# ── Express server ───────────────────────────────────────────
# PORT is the TCP port Express listens on.
# Vite dev-server proxy targets this same port.
PORT=3000

# NODE_ENV controls:
#   production  → serve frontend/dist as static files, hide error details,
#                 hard-exit if global-bundle.pem is missing
#   development → warn-only on missing cert, show full error messages
NODE_ENV=production

# ── Amazon DocumentDB connection ────────────────────────────
# DOCDB_HOST  : cluster endpoint from the AWS Console → DocumentDB → Clusters
# DOCDB_PORT  : always 27017 for DocumentDB
# DOCDB_USERNAME / DOCDB_PASSWORD : master credentials set at cluster creation
# DOCDB_DATABASE : logical database name created inside the cluster
#
# ⚠️  Write the password RAW (unencoded). The connection code in
#     backend/config/database.js calls encodeURIComponent() on it,
#     so pre-encoding the password will break authentication.
DOCDB_HOST=your-cluster.cluster-XXXXXXXXXXXX.us-east-1.docdb.amazonaws.com
DOCDB_PORT=27017
DOCDB_USERNAME=docdbadmin
DOCDB_PASSWORD=REPLACE_WITH_YOUR_PASSWORD
DOCDB_DATABASE=inspectiondb

# ── Feature flags ────────────────────────────────────────────

# ENABLE_QUERY_PLAYGROUND gates the two raw-filter endpoints:
#   GET  /api/queries/nested
#   POST /api/queries/custom
# Set to "true" only in development / demo environments.
# Leave "false" in production to avoid exposing a filter injection surface.
ENABLE_QUERY_PLAYGROUND=false

# ENABLE_TEMPLATE_WRITES gates the write routes on /api/templates:
#   POST   /api/templates
#   PUT    /api/templates/:type
#   DELETE /api/templates/:type
# GET routes on /api/templates are always available.
# Set to "true" only when you need to seed or modify templates.
# Leave "false" in production to prevent accidental template changes.
ENABLE_TEMPLATE_WRITES=false
